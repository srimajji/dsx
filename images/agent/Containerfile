FROM docker.io/library/ubuntu@sha256:b17516cd982bf06bdd5d5600253d12a8de017b9eb831cc052b532a0363d294f9

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates=20260601~24.04.1 \
    && rm -rf /var/lib/apt/lists/* \
    && sed -i 's|http://ports.ubuntu.com/ubuntu-ports/|https://snapshot.ubuntu.com/ubuntu/20260811T000000Z/|g' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        curl=8.5.0-2ubuntu10.11 \
        git=1:2.43.0-1ubuntu7.3 \
        openssh-client=1:9.6p1-3ubuntu13.18 \
        zsh=5.9-6ubuntu2 \
        ripgrep=14.1.0-1 \
        bat=0.24.0-1build1 \
        jq=1.7.1-3ubuntu0.24.04.2 \
        less=590-2ubuntu2.1 \
        tmux=3.4-1ubuntu0.1 \
        zip=3.0-13ubuntu0.2 \
        unzip=6.0-28ubuntu4.1 \
        build-essential=12.10ubuntu1 \
        python3=3.12.3-0ubuntu2.1 \
        python3-pip=24.0+dfsg-1ubuntu1.3 \
        python3-venv=3.12.3-0ubuntu2.1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 501 --gid 20 --create-home --shell /bin/zsh dsx

ENV SHELL=/bin/zsh \
    ZDOTDIR=/usr/local/share/dsx/shell \
    JAVA_HOME=/opt/java \
    STARSHIP_CONFIG=/usr/local/share/dsx/shell/starship.toml \
    PATH=/opt/node/bin:/opt/go/bin:/opt/java/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

COPY --from=artifacts /usr/local/bin/omp /usr/local/bin/omp
COPY --from=artifacts /usr/local/bin/claude /usr/local/bin/claude
COPY --from=artifacts /usr/local/bin/opencode /usr/local/bin/opencode
