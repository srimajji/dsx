COPY --chmod=0444 shell-toolchains.lock.json /usr/local/share/dsx/shell-toolchains.lock.json
COPY --chmod=0555 shell/dsx.zsh /usr/local/share/dsx/shell/dsx.zsh
COPY --chmod=0444 shell/zsh_plugins.txt shell/starship.toml /usr/local/share/dsx/shell/
COPY --chmod=0440 sudoers-dsx /etc/sudoers.d/dsx

RUN printf '%s\n' 'source /usr/local/share/dsx/shell/dsx.zsh' > /usr/local/share/dsx/shell/.zshrc \
    && chmod 0444 /usr/local/share/dsx/shell/.zshrc

RUN visudo -cf /etc/sudoers.d/dsx

RUN printf '%s\n' '/usr/local/share/dsx/shell/plugins/zsh-completions path:src kind:fpath' \
        | zsh -c 'source /opt/antidote/antidote.zsh; antidote bundle' \
        > /usr/local/share/dsx/shell/plugins-pre.zsh \
    && printf '%s\n' \
        '/usr/local/share/dsx/shell/plugins/fzf-tab' \
        '/usr/local/share/dsx/shell/plugins/zsh-history-substring-search' \
        '/usr/local/share/dsx/shell/plugins/zsh-autosuggestions' \
        '/usr/local/share/dsx/shell/plugins/zsh-syntax-highlighting' \
        | zsh -c 'source /opt/antidote/antidote.zsh; antidote bundle' \
        > /usr/local/share/dsx/shell/plugins-post.zsh \
    && zsh -fc 'source /usr/local/share/dsx/shell/plugins-pre.zsh; autoload -Uz compinit; compinit -i -d /usr/local/share/dsx/shell/zcompdump' \
    && zsh -fc 'zcompile -R /usr/local/share/dsx/shell/zcompdump.zwc /usr/local/share/dsx/shell/zcompdump' \
    && fzf --zsh > /usr/local/share/dsx/shell/fzf-init.zsh \
    && direnv hook zsh > /usr/local/share/dsx/shell/direnv-init.zsh \
    && starship init zsh > /usr/local/share/dsx/shell/starship-init.zsh \
    && chmod 0444 /usr/local/share/dsx/shell/plugins-pre.zsh \
        /usr/local/share/dsx/shell/plugins-post.zsh \
        /usr/local/share/dsx/shell/zcompdump \
        /usr/local/share/dsx/shell/zcompdump.zwc \
        /usr/local/share/dsx/shell/fzf-init.zsh \
        /usr/local/share/dsx/shell/direnv-init.zsh \
        /usr/local/share/dsx/shell/starship-init.zsh

LABEL io.dsx.harness-lock.sha256="0dbd480a8a9c325430c4237476e9feac7556857ef76c6432f965f3459a7b2650"

