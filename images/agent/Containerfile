FROM docker.io/library/ubuntu@sha256:3fe5b610f5c41eeeb56c2995bd4afb4990ac5b80dc980e33f9251eaaa8013615

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates=20260601~26.04.1 \
    && rm -rf /var/lib/apt/lists/* \
    && sed -i 's|http://ports.ubuntu.com/ubuntu-ports/|https://snapshot.ubuntu.com/ubuntu/20260811T000000Z/|g' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        curl=8.18.0-1ubuntu2.3 \
        git=1:2.53.0-1ubuntu1 \
        openssh-client=1:10.2p1-2ubuntu3.5 \
        zsh=5.9-8ubuntu3 \
        ripgrep=15.1.0-1ubuntu1 \
