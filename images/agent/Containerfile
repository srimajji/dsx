    && rm -rf /var/lib/apt/lists/* \
    && userdel --remove ubuntu \
    && groupadd --gid 1000 dsx \
    && useradd --uid 1000 --gid 1000 --create-home --shell /bin/zsh dsx

ENV HOME=/home/dsx \
