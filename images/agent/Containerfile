        python3-venv=3.14.3-0ubuntu2 \
        sudo=1.9.17p2-1ubuntu3 \
        groff=1.23.0-10 \
        libatomic1=16-20260322-1ubuntu1 \
        libc6=2.43-2ubuntu2.3 \
        libgcc-s1=16-20260322-1ubuntu1 \
