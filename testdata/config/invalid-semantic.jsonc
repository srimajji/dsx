{
  "schemaVersion": 1,
  "workspace": {
    "root": ".",
    "members": [
      { "name": "api", "path": "services" },
      { "name": "worker", "path": "services/worker" }
    ]
  },
  "image": { "ref": "ghcr.io/example/dev:latest" },
  "agents": { "default": "codex", "allowed": ["codex"] },
  "processes": {
    "web": { "argv": ["run-web"], "dependsOn": ["worker"] }
  }
}
